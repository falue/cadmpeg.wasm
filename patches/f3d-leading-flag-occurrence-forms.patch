+/// The three stored attributes of an occurrence: two flags and an empty time.
+fn attribute_run() -> Vec<u8> {
+    let mut run = Vec::new();
+    for (name, kind, value) in [
+        ("GatedByParent", "IntrinsicMetaTypebool", &[0_u8][..]),
+        ("ResolutionTime", "IntrinsicMetaTypeHString", &[0, 0, 0, 0][..]),
+        ("SelfGated", "IntrinsicMetaTypebool", &[0][..]),
+    ] {
+        for text in [name, kind] {
+            run.extend_from_slice(&u32::try_from(text.len()).unwrap().to_le_bytes());
+            run.extend_from_slice(text.as_bytes());
+        }
+        run.extend_from_slice(value);
+    }
+    run
+}
+
+#[test]
+fn a_leading_flag_frame_can_store_attributes_before_its_ordinal() {
+    for matrix in [false, true] {
+        let extra = if matrix { 128 } else { 0 };
+        let run = attribute_run();
+        let mut bytes = frame(matrix);
+        bytes[40..44].copy_from_slice(&3_u32.to_le_bytes());
+        bytes.splice(44..44, run.iter().copied());
+        let record = parse(&bytes).unwrap();
+        assert_eq!(record.owner_entity, 6);
+        assert_eq!(record.component_guid.as_str(), COMPONENT);
+        assert_eq!(
+            record.transform().map(|transform| transform.offset),
+            matrix.then_some(51 + run.len() as u64)
+        );
+        let wire = serde_json::to_value(&record).unwrap();
+        assert_eq!(wire["component_guid_offset"], 55 + extra + run.len());
+        assert_eq!(wire["occurrence_guid_offset"], 131 + extra + run.len());
+        assert_eq!(wire["owner_entity_offset"], 241 + 2 * extra + run.len());
+        assert_eq!(wire["leading_flag"]["attributes"][1]["name"], "ResolutionTime");
+        let decoded: DesignComponentOccurrence = serde_json::from_value(wire).unwrap();
+        assert_eq!(decoded, record);
+
+        let mut miscounted = bytes.clone();
+        miscounted[40..44].copy_from_slice(&2_u32.to_le_bytes());
+        assert!(parse(&miscounted).is_none());
+    }
+}
+
+#[test]
+fn a_flagless_identity_frame_stores_its_flag_only_in_the_body() {
+    let mut bytes = frame(false);
+    bytes.remove(50);
+    assert_eq!(bytes.len(), 250);
+    let record = parse(&bytes).unwrap();
+    assert_eq!(record.occurrence_ordinal(), 1);
+    assert!(record.transform().is_none());
+    let wire = serde_json::to_value(&record).unwrap();
+    assert_eq!(wire["component_guid_offset"], 54);
+    assert_eq!(wire["occurrence_guid_offset"], 130);
+    assert_eq!(wire["owner_entity_offset"], 240);
+    assert_eq!(wire["leading_flag"]["flagless"], true);
+    let decoded: DesignComponentOccurrence = serde_json::from_value(wire).unwrap();
+    assert_eq!(decoded, record);
+
+    // The body copy is the only flag, and it states identity.
+    let mut placed = bytes.clone();
+    placed[50 + 179] = 0;
+    assert!(parse(&placed).is_none());
+    // A fixed frame keeps its flag in the wire form's default.
+    let wire = serde_json::to_value(parse(&frame(false)).unwrap()).unwrap();
+    assert!(wire["leading_flag"].get("flagless").is_none());
+    assert!(wire["leading_flag"].get("attributes").is_none());
+}
