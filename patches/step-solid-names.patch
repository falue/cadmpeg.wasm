+#[test]
+fn writer_names_each_solid_after_its_body_on_both_paths() {
+    let solid_names = |step: &str| {
+        step.lines()
+            .filter_map(|line| line.split_once(" = MANIFOLD_SOLID_BREP('"))
+            .filter_map(|(_, rest)| rest.split('\'').next().map(str::to_owned))
+            .collect::<Vec<_>>()
+    };
+    let mut ir = unit_cube().expect("unit cube fixture is admitted");
+    ir.model.bodies[0].name = Some("Body 1".into());
+    assert_eq!(solid_names(&write_named(&ir, "Bracket model")), ["Body 1"]);
+
+    ir.model.product_definitions = vec![unnamed_definition(
+        "test:model:product-definition#part-0",
+        vec![ir.model.bodies[0].id.clone()],
+    )];
+    ir.model.occurrences = vec![unnamed_occurrence(
+        "test:model:occurrence#root",
+        "test:model:product-definition#part-0",
+        None,
+    )];
+    assert_eq!(solid_names(&write_named(&ir, "Bracket model")), ["Body 1"]);
+
+    ir.model.bodies[0].name = None;
+    assert_eq!(solid_names(&write_named(&ir, "Bracket model")), [""]);
+}
