+#[test]
+fn top_level_manifest_accepts_the_offline_save_marker_after_a_display_name() {
+    let manifest =
+        parse_top_level(&terminal_manifest(0, Some("Assembly"), "NA_OFFLINESAVE")).unwrap();
+    assert_eq!(manifest.asset_folder_bases, ["Design Base"]);
+    assert!(manifest.diagnostics.is_empty());
+    for marker in ["NA_EXPORT", "NA_OFFLINE"] {
+        assert!(parse_top_level(&terminal_manifest(0, Some("Assembly"), marker)).is_err());
+    }
+}
