+use std::collections::BTreeMap;
+
+use crate::design::decode::components::StreamComponents;
+use crate::loss::F3dLossCode;
+use crate::records::xref::XrefReference;
+use crate::scene::{DisplayPose, SceneBinding};
+use crate::xref::{OccurrencePlacementFailure, XrefTable};
+
+const STREAM: &str = "f3d:Design/BulkStream.dat";
+const ROLE: &str = "external-role";
+const ROOT_COMPONENT: u64 = 3;
+const CARRIER: u64 = 212;
+/// Quarter turns that map X to -Z and Z to -Y, with a millimetre translation.
+const POSE: [[f64; 4]; 4] = [
+    [0.0, 1.0, 0.0, 996.5],
+    [0.0, 0.0, -1.0, 26.0],
+    [-1.0, 0.0, 0.0, 190.25],
+    [0.0, 0.0, 0.0, 1.0],
+];
+
+fn unplaced_table(failures: usize) -> XrefTable {
+    XrefTable {
+        references: vec![XrefReference {
+            id: "f3d:xref:reference#0".to_owned(),
+            ordinal: 0,
+            occurrence_ordinal: 0,
+            placement_source: None,
+            from: "root.f3d".to_owned().try_into().unwrap(),
+            relative_path: "part.f3d".to_owned().try_into().unwrap(),
+            neutron_role: ROLE.to_owned().try_into().unwrap(),
+            neutron_data: String::new(),
+            transform: None,
+            current_pose: None,
+            operation_pose: None,
+            contained_poses: Vec::new(),
+            owned_poses: Vec::new(),
+        }],
+        placement_failures: (0..failures)
+            .map(|_| {
+                (
+                    STREAM.to_owned(),
+                    OccurrencePlacementFailure {
+                        carrier_record_index: Some(CARRIER),
+                        link_names: vec![ROLE.to_owned()],
+                    },
+                )
+            })
+            .collect(),
+        ..Default::default()
+    }
+}
+
+fn row(path: Vec<u64>, tagged_from: Option<u64>) -> DisplayPose {
+    DisplayPose {
+        id: format!("f3d:world:display-pose#{}", path[1]),
+        stream: "world".to_owned(),
+        byte_offset: 0,
+        path: path.try_into().unwrap(),
+        tagged_from,
+        transform: POSE.try_into().unwrap(),
+        binding: SceneBinding::Unbound {},
+    }
+}
+
+fn project(
+    table: &XrefTable,
+    display: &[DisplayPose],
+) -> super::super::ExternalOccurrenceProjection {
+    let components = BTreeMap::from([(
+        STREAM.to_owned(),
+        StreamComponents {
+            root_component: Some(ROOT_COMPONENT),
+            ..Default::default()
+        },
+    )]);
+    let sources = crate::design::components::LocalComponentSources {
+        scopes: &[],
+        occurrences: &[],
+        paths: &[],
+        components: &components,
+        body_bindings: &[],
+        bodies: None,
+        hidden_bodies: None,
+        root_ordinal_start: 1,
+        limits: cadmpeg_core::decode::ResourceLimits::default(),
+    };
+    super::super::project_occurrences(table, &sources, &[], display).unwrap()
+}
+
+fn codes(
+    projection: &super::super::ExternalOccurrenceProjection,
+) -> Vec<cadmpeg_ir::report::loss::LossKind> {
+    projection
+        .losses
+        .iter()
+        .map(|loss| loss.code.clone())
+        .collect()
+}
+
+#[test]
+fn undecoded_root_placement_takes_the_unique_display_pose_of_its_carrier() {
+    let display = [
+        row(vec![ROOT_COMPONENT, CARRIER], None),
+        row(vec![ROOT_COMPONENT, 4411], None),
+        row(vec![ROOT_COMPONENT, 7, 9, CARRIER], Some(2)),
+    ];
+    let projection = project(&unplaced_table(1), &display);
+    assert_eq!(projection.occurrences.len(), 1);
+    assert_eq!(projection.occurrences[0].transform.rows(), POSE);
+    assert_eq!(
+        codes(&projection),
+        [F3dLossCode::XrefPlacementDisplayPose.kind()]
+    );
+}
+
+#[test]
+fn undecoded_placement_without_a_unique_pose_or_carrier_keeps_the_identity() {
+    let pose = row(vec![ROOT_COMPONENT, CARRIER], None);
+    for (failures, display) in [
+        (1, vec![]),
+        (1, vec![pose.clone(), pose.clone()]),
+        (2, vec![pose.clone()]),
+        (1, vec![row(vec![ROOT_COMPONENT + 1, CARRIER], None)]),
+    ] {
+        let projection = project(&unplaced_table(failures), &display);
+        assert_eq!(
+            projection.occurrences[0].transform.rows(),
+            super::super::IDENTITY_ROWS
+        );
+        assert_eq!(
+            codes(&projection),
+            [F3dLossCode::XrefPlacementIdentityAssumed.kind()]
+        );
+    }
+}
