+    };
+    let stream = format!("{folder}/OGS.BlobFolder/OGS/DefaultScene/world");
+    match scan.entry_view(&stream) {
+        Some(view) => read(ctx, view, &stream, losses),
+        None => Ok(Vec::new()),
+    }
