+#[test]
+fn writer_names_the_sole_unnamed_root_definition_and_takes_the_document_name() {
+    let mut ir = unit_cube().expect("unit cube fixture is admitted");
+    let body = ir.model.bodies[0].id.clone();
+    let mut second = unnamed_definition("test:model:product-definition#second", Vec::new());
+    second.label = Some("Second part".into());
+    ir.model.product_definitions = vec![
+        unnamed_definition("test:model:product-definition#first", vec![body]),
+        second,
+    ];
+    ir.model.occurrences = vec![
+        named_root_occurrence(
+            "test:model:occurrence#first-root",
+            "test:model:product-definition#first",
+            "first-root",
+        ),
+        named_root_occurrence(
+            "test:model:occurrence#second-root",
+            "test:model:product-definition#second",
+            "second-root",
+        ),
+    ];
+    assert_eq!(
+        record_names(&write_named(&ir, "Assembly model"), "PRODUCT"),
+        ["Assembly model", "Second part", "Assembly model"]
+    );
+
+    let plan = StepCodec::default()
+        .plan(
+            EncodeInput {
+                name: Some("Hasi"),
+                ..EncodeInput::new(&ir, None)
+            },
+            TargetRequest::Explicit(StepSchema::Ap242Edition3.descriptor().id.as_str()),
+        )
+        .expect("plan named document");
+    let mut output = Vec::new();
+    plan.write_to(&mut output).expect("write named document");
+    let step = String::from_utf8(output).expect("STEP text");
+    assert!(step.contains("FILE_NAME('Hasi',"), "{step}");
+    assert_eq!(
+        record_names(&step, "PRODUCT"),
+        ["Hasi", "Second part", "Hasi"]
+    );
+}
